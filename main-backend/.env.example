# Copy to .env for local development. Never commit real values.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roots18_backend_development
REDIS_URL=redis://localhost:6379/0

# RS256 key that signs login tokens (PEM; "\n" for line breaks is fine).
# Development makes one in tmp/ automatically. Production requires it:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
JWT_PRIVATE_KEY=
# During key rotation: the old public key, so tokens it signed stay valid.
JWT_PREVIOUS_PUBLIC_KEY=
JWT_ISSUER=18roots-main-app
JWT_AUDIENCE=18roots-main-backend

# The Phase 1 meeting service. It must be given this backend's PUBLIC key as
# PLATFORM_JWT_PUBLIC_KEY, MEETING_CREATOR_ROLES=service, and
# EVENTS_WEBHOOK_URL=https://<this backend>/webhooks/meetings with the same secret.
MEETING_SERVICE_URL=http://localhost:3100
MEETING_SERVICE_AUDIENCE=18roots-meeting-service
MEETING_EVENTS_SECRET=development-meeting-events-secret

# Payments: "demo" (no money moves) or "payment_service" (Phase 2b).
PAYMENT_PROVIDER=demo
PAYMENT_SERVICE_URL=
PAYMENT_EVENTS_SECRET=
# Lets the app confirm demo payments. Never on a real production server.
DEMO_PAYMENTS=true

# SMS: "log" writes codes to the development log. A real provider is still to integrate.
SMS_PROVIDER=log
# Development and test servers only: every login code is this value.
OTP_FIXED_CODE=123456

CLINIC_TIME_ZONE=Asia/Kolkata
# Minutes before the start that Join opens (test servers can set 1440).
JOIN_OPENS_MINUTES_BEFORE=15
CORS_ORIGINS=http://localhost:8081
