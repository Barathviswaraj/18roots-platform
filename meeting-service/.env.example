COMPOSE_PROJECT_NAME=18roots-meeting

# Match the Linux account that owns the mounted source tree (check with `id -u` and `id -g`).
LOCAL_UID=1000
LOCAL_GID=1000

# Local-only development secrets. Change all values before any shared deployment.
POSTGRES_DB=meeting_development
POSTGRES_USER=meeting
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=postgresql://meeting:local-only-change-me@postgres:5432/meeting_development
REDIS_URL=redis://redis:6379/0

RAILS_ENV=development
RAILS_MAX_THREADS=5
SECRET_KEY_BASE=development-only-change-this-to-a-long-random-value
ALLOW_DEMO_AUTH=true
PLATFORM_JWT_SECRET=development-only-platform-jwt-secret-change-me
PLATFORM_JWT_ISSUER=18roots-main-app
PLATFORM_JWT_AUDIENCE=18roots-meeting-service
# Optional during key rotation: tokens signed with the old secret keep working.
PLATFORM_JWT_PREVIOUS_SECRET=
# Optional instead of a shared secret: the main backend's RS256 or ES256 public key (PEM).
PLATFORM_JWT_PUBLIC_KEY=
# Who may create meetings. Production: service (the main backend only).
# The local test app creates meetings as the doctor.
MEETING_CREATOR_ROLES=service,doctor

# Optional: the main backend's URL for signed meeting events, and the shared signing secret.
EVENTS_WEBHOOK_URL=
EVENTS_WEBHOOK_SECRET=

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_API_URL=http://livekit:7880
# For Android emulator use ws://10.0.2.2:7880; for a physical phone use ws://<computer-LAN-IP>:7880.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# The address LiveKit gives to clients for audio/video. For a physical phone, use this computer's LAN IP.
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_WEBHOOK_URL=http://api:3000/api/v1/livekit/webhook

CORS_ORIGINS=http://localhost:8081

