# Copy to .env. These values are bundled into the app, so never put secrets here.

# mock: the built-in demo backend (no server needed). live: the real main backend.
EXPO_PUBLIC_API_MODE=mock

# Live mode: the main backend and the Phase 1 meeting service.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_MEETING_API_URL=

# Optional in mock mode: a local meeting service (development mode, demo login on)
# lets you hold a real call with the meeting test app. Use this computer's Wi-Fi
# address, for example http://192.168.1.20:3000
# EXPO_PUBLIC_MEETING_API_URL=

EXPO_PUBLIC_SUPPORT_PHONE=+914400000000

# Testing only: show the meeting ID on the call screen so a doctor test app can join.
EXPO_PUBLIC_SHOW_MEETING_ID=false

# 0 to 1: share of demo requests that fail, to test retries and error screens.
EXPO_PUBLIC_MOCK_FAILURE_RATE=0
